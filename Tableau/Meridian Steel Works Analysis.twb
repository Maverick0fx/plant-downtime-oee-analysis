              <calculation class='tableau' formula='SUM(&#13;&#10;    IF LOWER(TRIM([RunID])) &lt;&gt; &quot;unknown&quot; THEN&#13;&#10;        [UnitsProduced]&#13;&#10;    END&#13;&#10;)' />
            </column>
            <column caption='Total Units Rejected' datatype='integer' name='[Calculation_0445087980294146]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([UnitsRejected])' />
            </column>
            <column caption='Reject Rate %' datatype='real' default-format='p0.00%' name='[Calculation_0445088256213007]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM(&#13;&#10;    IF LOWER(TRIM([RunID])) &lt;&gt; &quot;unknown&quot;&#13;&#10;    THEN [UnitsProduced]&#13;&#10;    END&#13;&#10;) &gt; 0&#13;&#10;THEN&#13;&#10;    SUM(&#13;&#10;        IF LOWER(TRIM([RunID])) &lt;&gt; &quot;unknown&quot;&#13;&#10;        THEN [UnitsRejected]&#13;&#10;        END&#13;&#10;    )&#13;&#10;    /&#13;&#10;    SUM(&#13;&#10;        IF LOWER(TRIM([RunID])) &lt;&gt; &quot;unknown&quot;&#13;&#10;        THEN [UnitsProduced]&#13;&#10;        END&#13;&#10;    )&#13;&#10;END' />
            </column>
            <column caption='Machine-Product Combination' datatype='string' name='[Calculation_0445088353173524]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[MachineID] + &quot; - &quot; + [ProductCode]' />
