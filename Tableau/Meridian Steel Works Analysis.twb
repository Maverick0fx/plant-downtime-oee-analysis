            <column caption='Downtime Rate %' datatype='real' name='[Calculation_0445088261984272]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([PlannedMinutes]) &gt; 0 THEN&#13;&#10;    SUM([DowntimeMinutes]) / SUM([PlannedMinutes])&#13;&#10;END' />
