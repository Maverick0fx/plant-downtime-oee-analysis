      <aliases enabled='yes' />
      <column caption='Total Machines' datatype='integer' name='[Calculation_0445087977865216]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF TRIM([MachineID]) &lt;&gt; &quot;unknown&quot;&#13;&#10;    THEN [MachineID]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Actual Units Produced' datatype='integer' name='[Calculation_0445087979843585]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF LOWER(TRIM([RunID])) &lt;&gt; &quot;unknown&quot; THEN&#13;&#10;        [UnitsProduced]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Total Units Rejected' datatype='integer' name='[Calculation_0445087980294146]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([UnitsRejected])' />
      </column>
      <column caption='Total Planned Minutes' datatype='integer' name='[Calculation_0445087981842435]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([PlannedMinutes])' />
      </column>
      <column caption='Total Downtime Minutes' datatype='integer' name='[Calculation_0445087982710788]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([DowntimeMinutes])' />
      </column>
      <column caption='Availability %' datatype='real' default-format='p0.00%' name='[Calculation_0445087983075333]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([PlannedMinutes]) &gt; 0 THEN&#13;&#10;    (&#13;&#10;        SUM([PlannedMinutes])&#13;&#10;        - SUM([DowntimeMinutes])&#13;&#10;    )&#13;&#10;    / SUM([PlannedMinutes])&#13;&#10;END' />
      </column>
      <column caption='Performance %' datatype='real' default-format='p0.00%' name='[Calculation_0445087985618952]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_0445088004542475] &gt; 0 THEN&#13;&#10;   [Calculation_0445087979843585] / [Calculation_0445088004542475]&#13;&#10;END' />
      </column>
      <column caption='Quality %' datatype='real' default-format='p0.00%' name='[Calculation_0445087985856521]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([UnitsProduced]) &gt; 0 THEN&#13;&#10;    (&#13;&#10;        SUM([UnitsProduced])&#13;&#10;        - SUM([UnitsRejected])&#13;&#10;    )&#13;&#10;    / SUM([UnitsProduced])&#13;&#10;END' />
      </column>
      <column caption='OEE' datatype='real' default-format='p0.00%' name='[Calculation_0445087986561034]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0445087983075333]*[Calculation_0445087985618952]*[Calculation_0445087985856521]' />
      </column>
      <column caption='Expected Unit Production' datatype='real' name='[Calculation_0445088004542475]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF LOWER(TRIM([RunID])) &lt;&gt; &quot;unknown&quot; THEN&#13;&#10;        [IdealRatePerMin] *&#13;&#10;        ([PlannedMinutes] - [DowntimeMinutes])&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Units Rejected per Run' datatype='real' name='[Calculation_0445088250261516]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(&#13;&#10;    IF LOWER(TRIM([RunID])) &lt;&gt; &quot;unknown&quot;&#13;&#10;    THEN [UnitsRejected]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Unknown RunID Count' datatype='integer' name='[Calculation_0445088252432397]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IIF(LOWER(TRIM([RunID])) = &quot;unknown&quot;, 1, 0)&#13;&#10;)' />
      </column>
      <column caption='Unknown RunId %' datatype='real' name='[Calculation_0445088252973070]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IIF(LOWER(TRIM([RunID])) = &quot;unknown&quot;, 1, 0)&#13;&#10;)&#13;&#10;/&#13;&#10;COUNT([RunID])' />
      </column>
      <column caption='Reject Rate %' datatype='real' default-format='p0.00%' name='[Calculation_0445088256213007]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM(&#13;&#10;    IF LOWER(TRIM([RunID])) &lt;&gt; &quot;unknown&quot;&#13;&#10;    THEN [UnitsProduced]&#13;&#10;    END&#13;&#10;) &gt; 0&#13;&#10;THEN&#13;&#10;    SUM(&#13;&#10;        IF LOWER(TRIM([RunID])) &lt;&gt; &quot;unknown&quot;&#13;&#10;        THEN [UnitsRejected]&#13;&#10;        END&#13;&#10;    )&#13;&#10;    /&#13;&#10;    SUM(&#13;&#10;        IF LOWER(TRIM([RunID])) &lt;&gt; &quot;unknown&quot;&#13;&#10;        THEN [UnitsProduced]&#13;&#10;        END&#13;&#10;    )&#13;&#10;END' />
      </column>
      <column caption='Downtime Rate %' datatype='real' name='[Calculation_0445088261984272]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([PlannedMinutes]) &gt; 0 THEN&#13;&#10;    SUM([DowntimeMinutes]) / SUM([PlannedMinutes])&#13;&#10;END' />
      </column>
      <column caption='Operating Minutes' datatype='integer' name='[Calculation_0445088262516753]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([PlannedMinutes]) - SUM([DowntimeMinutes])' />
      </column>
      <column caption='Production Shortfall %' datatype='real' default-format='p0.00%' name='[Calculation_0445088276316179]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_0445088004542475] &gt; 0 THEN&#13;&#10;    (&#13;&#10;        [Calculation_0445088004542475] - [Calculation_0445087979843585]&#13;&#10;    )&#13;&#10;    / [Calculation_0445088004542475]&#13;&#10;END' />
      </column>
      <column caption='Machine-Product Combination' datatype='string' name='[Calculation_0445088353173524]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[MachineID] + &quot; - &quot; + [ProductCode]' />
      </column>
      <column caption='Calculation1' datatype='real' name='[Calculation_0445088692203541]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([PlannedMinutes]-[DowntimeMinutes])*[IdealRatePerMin]' />
      </column>
      <column caption='Downtime Minutes' datatype='integer' name='[DowntimeMinutes]' role='measure' type='quantitative' />
      <column caption='Energy K Wh' datatype='real' name='[EnergyKWh]' role='measure' type='quantitative' />
      <column caption='Ideal Rate Per Min' datatype='real' name='[IdealRatePerMin]' role='measure' type='quantitative' />
