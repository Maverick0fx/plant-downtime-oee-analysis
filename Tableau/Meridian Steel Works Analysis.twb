    <worksheet name='Quality %'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontsize='10'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='cleaned (meridian_production_cleaned)' name='federated.0d7sef70cgx2ea15vlz0q0g6bkde' />
          </datasources>
          <datasource-dependencies datasource='federated.0d7sef70cgx2ea15vlz0q0g6bkde'>
            <column caption='Quality %' datatype='real' default-format='p0.00%' name='[Calculation_0445087985856521]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([UnitsProduced]) &gt; 0 THEN&#13;&#10;    (&#13;&#10;        SUM([UnitsProduced])&#13;&#10;        - SUM([UnitsRejected])&#13;&#10;    )&#13;&#10;    / SUM([UnitsProduced])&#13;&#10;END' />
