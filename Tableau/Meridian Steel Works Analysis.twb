    <worksheet name='Energy consumption by machine'>
      <table>
        <view>
          <datasources>
            <datasource caption='cleaned (meridian_production_cleaned)' name='federated.0d7sef70cgx2ea15vlz0q0g6bkde' />
          </datasources>
          <datasource-dependencies datasource='federated.0d7sef70cgx2ea15vlz0q0g6bkde'>
            <column caption='Actual Units Produced' datatype='integer' name='[Calculation_0445087979843585]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;    IF LOWER(TRIM([RunID])) &lt;&gt; &quot;unknown&quot; THEN&#13;&#10;        [UnitsProduced]&#13;&#10;    END&#13;&#10;)' />
            </column>
            <column caption='Performance %' datatype='real' default-format='p0.00%' name='[Calculation_0445087985618952]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_0445088004542475] &gt; 0 THEN&#13;&#10;   [Calculation_0445087979843585] / [Calculation_0445088004542475]&#13;&#10;END' />
            </column>
            <column caption='Expected Unit Production' datatype='real' name='[Calculation_0445088004542475]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;    IF LOWER(TRIM([RunID])) &lt;&gt; &quot;unknown&quot; THEN&#13;&#10;        [IdealRatePerMin] *&#13;&#10;        ([PlannedMinutes] - [DowntimeMinutes])&#13;&#10;    END&#13;&#10;)' />
            </column>
            <column caption='Downtime Minutes' datatype='integer' name='[DowntimeMinutes]' role='measure' type='quantitative' />
            <column caption='Energy K Wh' datatype='real' name='[EnergyKWh]' role='measure' type='quantitative' />
            <column caption='Ideal Rate Per Min' datatype='real' name='[IdealRatePerMin]' role='measure' type='quantitative' />
            <column caption='Machine ID' datatype='string' name='[MachineID]' role='dimension' type='nominal' />
            <column caption='Planned Minutes' datatype='integer' name='[PlannedMinutes]' role='measure' type='quantitative' />
            <column caption='Run ID' datatype='string' name='[RunID]' role='dimension' type='nominal' />
            <column caption='Units Produced' datatype='integer' name='[UnitsProduced]' role='measure' type='quantitative' />
            <column-instance column='[MachineID]' derivation='None' name='[none:MachineID:nk]' pivot='key' type='nominal' />
            <column-instance column='[EnergyKWh]' derivation='Sum' name='[sum:EnergyKWh:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_0445087979843585]' derivation='User' name='[usr:Calculation_0445087979843585:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_0445087985618952]' derivation='User' name='[usr:Calculation_0445087985618952:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0d7sef70cgx2ea15vlz0q0g6bkde].[:Measure Names]'>
            <groupfilter function='union' user:op='manual'>
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.0d7sef70cgx2ea15vlz0q0g6bkde].[sum:EnergyKWh:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.0d7sef70cgx2ea15vlz0q0g6bkde].[usr:Calculation_0445087979843585:qk]&quot;' />
            </groupfilter>
          </filter>
