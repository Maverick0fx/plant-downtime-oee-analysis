              <calculation class='tableau' formula='AVG(&#13;&#10;    IF LOWER(TRIM([RunID])) &lt;&gt; &quot;unknown&quot;&#13;&#10;    THEN [UnitsRejected]&#13;&#10;    END&#13;&#10;)' />
