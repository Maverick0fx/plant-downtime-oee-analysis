            </column>
            <column caption='Expected Unit Production' datatype='real' name='[Calculation_0445088004542475]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;    IF LOWER(TRIM([RunID])) &lt;&gt; &quot;unknown&quot; THEN&#13;&#10;        [IdealRatePerMin] *&#13;&#10;        ([PlannedMinutes] - [DowntimeMinutes])&#13;&#10;    END&#13;&#10;)' />
            </column>
            <column caption='Production Shortfall %' datatype='real' default-format='p0.00%' name='[Calculation_0445088276316179]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_0445088004542475] &gt; 0 THEN&#13;&#10;    (&#13;&#10;        [Calculation_0445088004542475] - [Calculation_0445087979843585]&#13;&#10;    )&#13;&#10;    / [Calculation_0445088004542475]&#13;&#10;END' />
            </column>
            <column caption='Downtime Minutes' datatype='integer' name='[DowntimeMinutes]' role='measure' type='quantitative' />
